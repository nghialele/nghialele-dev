KENER_API_TOKEN=
KENER_API_BASE_URL=
KENER_PAGE_PATH=

# Server-side only: read by functions/api/presence.ts, never inlined into the page.
# LANYARD_API_KEY is a secret (64 chars); mark it encrypted in Cloudflare Pages.
LANYARD_API_KEY=
LANYARD_API_BASE_URL=https://api.lanyard.rest/v1/users
LANYARD_USER_ID=

# Optional build-time override for the presence URL the browser calls.
# Defaults to the same-origin proxy at /api/presence.
PUBLIC_LANYARD_ENDPOINT=
