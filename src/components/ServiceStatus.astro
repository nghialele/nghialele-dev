---

interface Props {
    endpoint?: string;
    monitorId?: string;
    label?: string;
}

const { endpoint = "", monitorId = "", label = "Status unavailable" } = Astro.props as Props;
---

<span
    class="inline-flex items-center gap-1.5 text-xs text-muted-foreground"
    data-service-status
    data-endpoint={endpoint || undefined}
    data-monitor-id={monitorId || undefined}
    data-fallback-label={label}
>
    <span class="size-1.5 rounded-full bg-muted-foreground/50" data-service-status-dot aria-hidden="true"></span>
    <span data-service-status-label>{label}</span>
</span>

{endpoint && monitorId && (
    <script>
        import { fetchServiceStatuses } from "../lib/kener";

        const status = document.currentScript?.previousElementSibling;
        const endpoint = status?.getAttribute("data-endpoint") ?? "";
        const monitorId = status?.getAttribute("data-monitor-id") ?? "";
        const label = status?.querySelector("[data-service-status-label]");
        const dot = status?.querySelector("[data-service-status-dot]");
        const colors = {
            operational: "bg-success",
            degraded: "bg-warning",
            outage: "bg-caution",
            unknown: "bg-muted-foreground/50",
        };

        fetchServiceStatuses(endpoint, [monitorId]).then((results) => {
            const result = results[monitorId];
            if (!result || !label || !dot) return;
            label.textContent = result.label;
            dot.className = `size-1.5 rounded-full ${colors[result.status]}`;
        });
    </script>
)}
