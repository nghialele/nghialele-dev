---
import { Globe, Monitor, Smartphone, X } from "@lucide/astro";
import { presenceConfigured } from "../lib/presence";

interface Props {
    variant?: "panel" | "beacon";
}

const variant = Astro.props.variant ?? "panel";
const endpoint = import.meta.env.PUBLIC_LANYARD_ENDPOINT || "https://lanyard.idler.me/v1/users";
const userId = import.meta.env.PUBLIC_LANYARD_USER_ID ?? "";
const key = import.meta.env.PUBLIC_LANYARD_KEY ?? "";
const configured = presenceConfigured();
---

{configured && variant === "panel" && (
    <aside
        class="rounded-lg border border-border/70 bg-card p-5"
        data-signal
        data-variant="panel"
        data-endpoint={endpoint}
        data-user-id={userId}
        data-key={key}
        data-state="unavailable"
        aria-label="Discord presence"
    >
        <p class="mb-3 text-[10px] uppercase tracking-[0.2em] text-muted-foreground">on the wire</p>
        <div class="flex items-start gap-4">
            <img
                data-signal-avatar
                width="56"
                height="56"
                alt=""
                hidden
                class="h-14 w-14 shrink-0 rounded-full bg-muted object-cover"
            />
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="signal-dot" data-signal-dot data-pulse="false" aria-hidden="true"></span>
                    <p class="truncate font-medium" data-signal-name>discord</p>
                    <span class="text-xs text-muted-foreground" data-signal-state>tuning in…</span>
                </div>
                <p class="mt-1 text-sm italic text-muted-foreground" data-signal-custom hidden></p>
                <div class="mt-3 flex items-center gap-3" data-signal-activity hidden>
                    <img
                        data-signal-activity-image
                        width="48"
                        height="48"
                        alt=""
                        hidden
                        class="h-12 w-12 shrink-0 rounded-md bg-muted object-cover"
                    />
                    <div class="min-w-0">
                        <p class="text-sm font-medium truncate" data-signal-activity-name></p>
                        <p class="text-xs text-muted-foreground truncate" data-signal-activity-detail></p>
                        <p class="text-xs text-muted-foreground" data-signal-elapsed hidden></p>
                    </div>
                </div>
                <div class="mt-3 flex items-center gap-3" data-signal-spotify hidden>
                    <img
                        data-signal-album
                        width="48"
                        height="48"
                        alt=""
                        class="h-12 w-12 shrink-0 rounded-md bg-muted object-cover"
                    />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium truncate" data-signal-song></p>
                        <p class="text-xs text-muted-foreground truncate" data-signal-artist></p>
                        <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted" aria-hidden="true">
                            <div class="h-full bg-accent" data-signal-progress style="width:0%"></div>
                        </div>
                        <p class="mt-1 text-[10px] tabular-nums text-muted-foreground" data-signal-time></p>
                    </div>
                </div>
                <div class="mt-3 flex items-center gap-2 text-muted-foreground" data-signal-devices hidden>
                    <span data-device="desktop" title="desktop" hidden>
                        <Monitor size={14} aria-hidden="true" />
                    </span>
                    <span data-device="mobile" title="mobile" hidden>
                        <Smartphone size={14} aria-hidden="true" />
                    </span>
                    <span data-device="web" title="web" hidden>
                        <Globe size={14} aria-hidden="true" />
                    </span>
                </div>
            </div>
        </div>
    </aside>
)}

{configured && variant === "beacon" && (
    <div
        class="fixed bottom-4 right-4 z-40 flex max-w-[min(22rem,calc(100vw_-_2rem))] items-center gap-2 rounded-full border border-border/70 bg-card/90 px-3 py-1.5 shadow-lg backdrop-blur"
        data-signal
        data-variant="beacon"
        data-endpoint={endpoint}
        data-user-id={userId}
        data-key={key}
        data-state="unavailable"
        aria-label="Discord presence"
        hidden
    >
        <span class="signal-dot" data-signal-dot data-pulse="false" aria-hidden="true"></span>
        <span class="max-w-[8rem] truncate text-xs font-medium" data-signal-name></span>
        <span class="max-w-[14rem] truncate text-xs text-muted-foreground" data-signal-summary>tuning in…</span>
        <button
            type="button"
            data-signal-dismiss
            aria-label="Mute the signal"
            title="Mute"
            class="rounded-full p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
            <X size={14} aria-hidden="true" />
        </button>
    </div>
)}

{configured && (
    <script>
        import { fetchPresence, type PresenceResult } from "../lib/presence";

        const LABELS = {
            online: "online",
            idle: "idle",
            dnd: "do not disturb",
            offline: "offline",
            unavailable: "no signal",
        };
        const STORAGE_KEY = "signal-muted";
        const POLL_MS = 30_000;

        const root = document.querySelector<HTMLElement>("[data-signal]");
        if (root) {
            const variant = root.dataset.variant ?? "panel";
            const endpoint = root.dataset.endpoint ?? "";
            const userId = root.dataset.userId ?? "";
            const key = root.dataset.key ?? "";
            const isBeacon = variant === "beacon";

            const q = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector);
            const thought = document.querySelector<HTMLElement>("[data-thought]");
            const thoughtText = document.querySelector<HTMLElement>("[data-thought-text]");
            const setText = (selector: string, value: string) => {
                const node = q(selector);
                if (node) node.textContent = value;
            };
            const setHidden = (selector: string, hide: boolean) => {
                const node = q(selector);
                if (node) node.hidden = hide;
            };
            const formatDuration = (ms: number) => {
                const seconds = Math.max(0, Math.floor(ms / 1000));
                if (seconds < 60) return `${seconds}s`;
                const minutes = Math.floor(seconds / 60);
                if (minutes < 60) return `${minutes}m`;
                return `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
            };
            const formatClock = (ms: number) => {
                const seconds = Math.max(0, Math.floor(ms / 1000));
                return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
            };

            let current: PresenceResult | undefined;
            let stopped = false;
            let pollTimer: ReturnType<typeof setInterval> | undefined;
            let tickTimer: ReturnType<typeof setInterval> | undefined;

            for (const selector of ["[data-signal-avatar]", "[data-signal-activity-image]", "[data-signal-album]"]) {
                const image = q<HTMLImageElement>(selector);
                image?.addEventListener("error", () => {
                    image.hidden = true;
                });
            }

            const tick = () => {
                if (!current || isBeacon) return;
                const now = Date.now();
                const activity = current.activity;
                if (activity?.startedAt) {
                    setHidden("[data-signal-elapsed]", false);
                    setText("[data-signal-elapsed]", `for ${formatDuration(now - activity.startedAt)}`);
                }
                const spotify = current.spotify;
                if (spotify?.startedAt && spotify.endsAt) {
                    const span = spotify.endsAt - spotify.startedAt;
                    const ratio = span > 0 ? Math.min(1, Math.max(0, (now - spotify.startedAt) / span)) : 0;
                    const bar = q<HTMLElement>("[data-signal-progress]");
                    if (bar) bar.style.width = `${Math.round(ratio * 100)}%`;
                    setText("[data-signal-time]", `${formatClock(now - spotify.startedAt)} / ${formatClock(span)}`);
                }
            };

            const render = (result: PresenceResult) => {
                current = result;
                root.dataset.state = result.state;
                const dot = q<HTMLElement>("[data-signal-dot]");
                if (dot) dot.dataset.pulse = result.state === "online" ? "true" : "false";

                const name = result.displayName ?? "";

                const status = result.customStatus?.trim();
                if (thought && thoughtText) {
                    thought.hidden = !status;
                    if (status) thoughtText.textContent = status;
                }

                if (isBeacon) {
                    root.hidden = false;
                    setText("[data-signal-name]", name);
                    setText(
                        "[data-signal-summary]",
                        result.spotify
                            ? `listening: ${result.spotify.song}`
                            : result.activity?.name ?? result.customStatus ?? LABELS[result.state],
                    );
                    return;
                }

                root.hidden = false;
                setText("[data-signal-name]", name || "discord");
                setText("[data-signal-state]", LABELS[result.state]);

                const avatar = q<HTMLImageElement>("[data-signal-avatar]");
                if (avatar && result.avatarUrl) {
                    avatar.src = result.avatarUrl;
                    avatar.alt = `${name || "discord"}'s avatar`;
                    avatar.hidden = false;
                }

                setHidden("[data-signal-custom]", !result.customStatus);
                if (result.customStatus) setText("[data-signal-custom]", result.customStatus);

                const activity = result.activity;
                setHidden("[data-signal-activity]", !activity?.name);
                if (activity?.name) {
                    setText("[data-signal-activity-name]", activity.name);
                    setText("[data-signal-activity-detail]", [activity.details, activity.state].filter(Boolean).join(" · "));
                    const image = q<HTMLImageElement>("[data-signal-activity-image]");
                    if (image && activity.imageUrl) {
                        image.src = activity.imageUrl;
                        image.hidden = false;
                    }
                    setHidden("[data-signal-elapsed]", !activity.startedAt);
                }

                const spotify = result.spotify;
                setHidden("[data-signal-spotify]", !spotify);
                if (spotify) {
                    setText("[data-signal-song]", spotify.song);
                    setText("[data-signal-artist]", spotify.artist);
                    const album = q<HTMLImageElement>("[data-signal-album]");
                    if (album && spotify.albumArtUrl) album.src = spotify.albumArtUrl;
                }

                const devices = result.devices;
                const anyDevice = devices.desktop || devices.mobile || devices.web;
                setHidden("[data-signal-devices]", !anyDevice);
                for (const [key, active] of Object.entries(devices)) {
                    const node = q<HTMLElement>(`[data-device="${key}"]`);
                    if (node) node.hidden = !active;
                }

                tick();
            };

            const refresh = async () => {
                if (stopped) return;
                const result = await fetchPresence(endpoint, userId, key);
                if (!stopped) render(result);
            };

            const dismiss = () => {
                stopped = true;
                if (pollTimer) clearInterval(pollTimer);
                if (tickTimer) clearInterval(tickTimer);
                sessionStorage.setItem(STORAGE_KEY, "1");
                root.hidden = true;
            };

            if (!isBeacon || sessionStorage.getItem(STORAGE_KEY) !== "1") {
                q<HTMLElement>("[data-signal-dismiss]")?.addEventListener("click", dismiss);
                void refresh();
                pollTimer = setInterval(() => {
                    if (document.visibilityState === "visible") void refresh();
                }, POLL_MS);
                document.addEventListener("visibilitychange", () => {
                    if (document.visibilityState === "visible") void refresh();
                });
                if (!isBeacon) tickTimer = setInterval(tick, 1000);
            }
        }
    </script>
)}
