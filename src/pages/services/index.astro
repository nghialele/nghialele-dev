---
import { Server, Network, Wrench } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import { info } from "../../lib/info";

const services = [
    {
        name: "Tools & software",
        description: "A few useful tools and software that I host myself.",
        icon: Server,
    },
    {
        name: "Relays & proxies",
        description: "Self-hosted relays and proxies for sharing with others.",
        icon: Network,
    },
    {
        name: "IT help",
        description: "Common IT services and support.",
        icon: Wrench,
    },
];
---

<Base
    title={`Services - ${info.site.name}`}
    description={`Public services and IT support from ${info.name}.`}
>
    <section class="container mx-auto px-6 pt-16 pb-20">
        <div class="max-w-3xl mx-auto">
            <header class="mb-10">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">services</h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    I host some services myself and you are welcome to use. Ask me for details or availability.
                </p>
            </header>

            <ul class="divide-y divide-border/40 border-t border-border/40">
                {services.map((service) => (
                    <li class="flex gap-4 py-5">
                        <service.icon size={20} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
                        <div>
                            <h2 class="font-medium text-foreground">{service.name}</h2>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{service.description}</p>
                        </div>
                    </li>
                ))}
            </ul>

            <p class="mt-8 text-sm text-muted-foreground">
                Interested? <a
                    href={`mailto:${info.contacts.find((contact) => contact.label === "email")?.text}`}
                    class="text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent transition-colors"
                >Get in touch.</a>
            </p>
        </div>
    </section>
</Base>
