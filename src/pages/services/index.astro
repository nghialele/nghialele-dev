---
import { ExternalLink, Mail, Server } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import { info, services } from "../../lib/info";

const email = info.contacts.find((contact) => contact.label === "email");
const requestHref = email?.href ?? "#";
---

<Base
    title={`Services - ${info.site.name}`}
    description={`Public services and access information from ${info.name}.`}
>
    <section class="container mx-auto px-6 pt-16 pb-20">
        <div class="max-w-3xl mx-auto">
            <header class="mb-10">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">services</h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    Services I host and make available. Public links are ready to use; private services can be requested.
                </p>
            </header>

            {services.length > 0 ? (
                <ul class="grid gap-3 sm:grid-cols-2" data-service-list>
                    {services.map((service) => (
                        <li
                            class="rounded-lg border border-border/70 bg-card p-4"
                            data-service-card
                            data-service-id={service.id}
                            data-service-url={service.url}
                        >
                            <div class="flex items-start gap-3">
                                <BrandIcon
                                    icon={service.icon}
                                    label={`${service.name ?? service.id} logo`}
                                    class="size-8 shrink-0 text-accent"
                                />
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                                        <h2 class="text-sm font-medium text-foreground" data-service-name>
                                            {service.name ?? service.id}
                                        </h2>
                                        <span
                                            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground"
                                            data-service-status
                                            hidden
                                        >
                                            <span
                                                class="size-1.5 rounded-full bg-muted-foreground/50"
                                                data-service-status-dot
                                                aria-hidden="true"
                                            ></span>
                                            <span data-service-status-label></span>
                                        </span>
                                    </div>

                                    <p
                                        class="mt-1 text-xs leading-relaxed text-muted-foreground line-clamp-2"
                                        data-service-description
                                        hidden
                                    ></p>

                                    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs">
                                        <a
                                            data-service-link
                                            hidden
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-1 font-medium text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                                        >
                                            Visit service
                                            <ExternalLink size={12} aria-hidden="true" />
                                        </a>

                                        {service.instructions && (
                                            <span class="text-muted-foreground">{service.instructions}</span>
                                        )}

                                        {service.requestAccess && (
                                            <a
                                                href={requestHref}
                                                class="inline-flex items-center gap-1 font-medium text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                                            >
                                                <Mail size={12} aria-hidden="true" />
                                                Request access
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            ) : (
                <div class="rounded-lg border border-dashed border-border p-8 text-center" role="status">
                    <Server size={28} class="mx-auto text-muted-foreground" aria-hidden="true" />
                    <h2 class="mt-3 font-medium">Service listings are being prepared</h2>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        Check back soon, or contact me if you are interested in using a hosted service.
                    </p>
                    <a
                        href={requestHref}
                        class="mt-4 inline-flex text-sm font-medium text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                    >
                        Get in touch
                    </a>
                </div>
            )}
        </div>
    </section>
</Base>

<script>
    import { fetchKenerServices, kenerStatusLabels } from "../../lib/kener";

    const dotClasses: Record<string, string> = {
        operational: "bg-success",
        degraded: "bg-warning",
        outage: "bg-caution",
        unknown: "bg-muted-foreground/50",
    };

    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-service-card]"));
    const ids = cards
        .map((card) => card.getAttribute("data-service-id") ?? "")
        .filter(Boolean);

    if (ids.length > 0) {
        fetchKenerServices("/api/services", ids).then((results) => {
            for (const card of cards) {
                const id = card.getAttribute("data-service-id");
                if (!id) continue;
                const service = results[id];
                if (!service) continue;

                const name = card.querySelector("[data-service-name]");
                if (name && service.name) name.textContent = service.name;

                const description = card.querySelector<HTMLElement>("[data-service-description]");
                if (description && service.description) {
                    description.textContent = service.description;
                    description.removeAttribute("hidden");
                }

                const status = card.querySelector<HTMLElement>("[data-service-status]");
                const statusLabel = card.querySelector("[data-service-status-label]");
                const statusDot = card.querySelector<HTMLElement>("[data-service-status-dot]");
                if (status && statusLabel && statusDot) {
                    statusLabel.textContent = kenerStatusLabels[service.status];
                    statusDot.className = `size-1.5 rounded-full ${dotClasses[service.status]}`;
                    status.removeAttribute("hidden");
                }

                const url = card.getAttribute("data-service-url") || service.url;
                if (url) {
                    const link = card.querySelector<HTMLAnchorElement>("[data-service-link]");
                    if (link) {
                        link.href = url;
                        try {
                            link.firstChild!.textContent = new URL(url).host;
                        } catch {
                            link.firstChild!.textContent = url;
                        }
                        link.removeAttribute("hidden");
                    }
                }
            }
        });
    }
</script>
