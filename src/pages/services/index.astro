---
import { Mail, Server } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import ServiceStatus from "../../components/ServiceStatus.astro";
import { info, services } from "../../lib/info";

const publishedServices = services.filter((service) => service.published);
const email = info.contacts.find((contact) => contact.label === "email");
const requestHref = email?.href ?? "#";
---

<Base
    title={`Services - ${info.site.name}`}
    description={`Public services and access information from ${info.name}.`}
>
    <section class="container mx-auto px-6 pt-16 pb-20">
        <div class="max-w-3xl mx-auto">
            <header class="mb-10">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">services</h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    Services I host and make available. Public links are ready to use; private services can be requested.
                </p>
            </header>

            {publishedServices.length > 0 ? (
                <ul class="space-y-5">
                    {publishedServices.map((service) => (
                        <li class="rounded-lg border border-border/70 bg-card p-5">
                            <div class="flex items-start gap-4">
                                <BrandIcon icon={service.icon} label={`${service.name} logo`} class="size-9 shrink-0 text-accent" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div>
                                            <h2 class="font-medium text-foreground">{service.name}</h2>
                                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{service.description}</p>
                                        </div>
                                        <ServiceStatus
                                            endpoint={info.status?.endpoint}
                                            monitorId={service.status?.monitorId}
                                            label={service.status?.label}
                                        />
                                    </div>

                                    <div class="mt-5 grid gap-4 border-t border-border/60 pt-4 sm:grid-cols-2">
                                        <section>
                                            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Public access</h3>
                                            {service.publicAccess.available && service.publicAccess.url ? (
                                                <a
                                                    href={service.publicAccess.url}
                                                    target={service.publicAccess.external ? "_blank" : undefined}
                                                    rel={service.publicAccess.external ? "noopener noreferrer" : undefined}
                                                    class="mt-2 inline-flex text-sm font-medium text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                                                >
                                                    {service.publicAccess.label ?? "Open service"}
                                                </a>
                                            ) : (
                                                <p class="mt-2 text-sm text-muted-foreground">Not publicly available.</p>
                                            )}
                                            {service.publicAccess.instructions && (
                                                <p class="mt-1 text-sm text-muted-foreground">{service.publicAccess.instructions}</p>
                                            )}
                                        </section>

                                        <section>
                                            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Private access</h3>
                                            <p class="mt-2 text-sm text-muted-foreground">
                                                {service.privateAccess.instructions ?? "Request access for private use."}
                                            </p>
                                            <a
                                                href={service.privateAccess.requestHref ?? requestHref}
                                                class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                                            >
                                                <Mail size={14} aria-hidden="true" />
                                                Request access
                                            </a>
                                        </section>
                                    </div>
                                    {(service.status?.badgeUrl || service.status?.embedUrl) && (
                                        <div class="mt-4 flex flex-wrap gap-3 border-t border-border/60 pt-4">
                                            {service.status.badgeUrl && (
                                                <a
                                                    href={service.status.badgeUrl}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-xs text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                                                >
                                                    Kener status badge
                                                </a>
                                            )}
                                            {service.status.embedUrl && (
                                                <a
                                                    href={service.status.embedUrl}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-xs text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                                                >
                                                    View status embed
                                                </a>
                                            )}
                                        </div>
                                    )}
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            ) : (
                <div class="rounded-lg border border-dashed border-border p-8 text-center" role="status">
                    <Server size={28} class="mx-auto text-muted-foreground" aria-hidden="true" />
                    <h2 class="mt-3 font-medium">Service listings are being prepared</h2>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        Check back soon, or contact me if you are interested in using a hosted service.
                    </p>
                    <a
                        href={requestHref}
                        class="mt-4 inline-flex text-sm font-medium text-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent"
                    >
                        Get in touch
                    </a>
                </div>
            )}
        </div>
    </section>
</Base>
