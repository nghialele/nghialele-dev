---
import { Code, Terminal, Server, Wrench } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import { info } from "../../lib/info";

const categoryIcons = [Code, Terminal, Server, Wrench];
---

<Base
    title={`Uses - ${info.site.name}`}
    description={`Languages, frameworks, infrastructure, and practices in ${info.name}'s toolkit.`}
>
    <section class="container mx-auto px-6 pt-16 pb-20">
        <div class="max-w-3xl mx-auto">
            <header class="mb-10">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">uses</h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    A snapshot of the languages, frameworks, infrastructure, and practices in my toolkit.
                </p>
            </header>

            <div class="space-y-10">
                {info.resume.skills.map((group, index) => {
                    const CategoryIcon = categoryIcons[index % categoryIcons.length];
                    return (
                        <section aria-labelledby={`uses-${index}`}>
                            <h2
                                id={`uses-${index}`}
                                class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                            >
                                <CategoryIcon size={16} aria-hidden="true" />
                                {group.category}
                            </h2>
                            <ul class="flex flex-wrap gap-2">
                                {group.items.map((item) => (
                                    <li class="rounded-md border border-border/70 bg-card px-3 py-1.5 text-sm text-foreground/85">
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    );
                })}
            </div>
        </div>
    </section>
</Base>
