---
import { Code, Server, Wrench, Workflow } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import PresenceCard from "../../components/PresenceCard.astro";
import { info, uses } from "../../lib/info";

const categoryIcons = [Code, Workflow, Server, Wrench];
---

<Base
    title={`Uses - ${info.site.name}`}
    description={`Languages, frameworks, infrastructure, and practices in ${info.name}'s toolkit.`}
>
    <section class="container mx-auto px-6 pt-16 pb-20">
        <div class="max-w-3xl mx-auto">
            <header class="mb-10">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">uses</h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    A snapshot of the languages, frameworks, infrastructure, and practices in my toolkit.
                </p>
            </header>

            <div class="space-y-10">
                {uses.map((group, index) => {
                    const CategoryIcon = categoryIcons[index % categoryIcons.length];
                    return (
                        <section aria-labelledby={`uses-${index}`}>
                            <h2
                                id={`uses-${index}`}
                                class="mb-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                            >
                                <CategoryIcon size={16} aria-hidden="true" />
                                {group.category}
                            </h2>
                            <ul class="flex flex-wrap items-end gap-3" aria-label={group.category}>
                                {group.items.map((item, itemIndex) => (
                                    <li
                                        class:list={[
                                            "group flex items-center gap-2 rounded-lg border border-border/70 bg-card px-3 py-3 text-sm text-foreground/85 transition-transform hover:-translate-y-1 hover:border-accent/50 hover:text-accent",
                                            itemIndex % 3 === 0 && "sm:-rotate-1",
                                            itemIndex % 3 === 1 && "sm:rotate-1",
                                        ]}
                                    >
                                        <BrandIcon icon={item.icon} label={`${item.name} logo`} class="size-7" />
                                        <span>{item.name}</span>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    );
                })}
            </div>

            <div class="mt-12">
                <PresenceCard />
            </div>
        </div>
    </section>
</Base>
